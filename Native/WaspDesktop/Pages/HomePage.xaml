<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WaspDesktop.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="24,16,24,16" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Main Dashboard" />

            <TextBlock
                x:Name="ConnectionStatusText"
                Grid.Row="1"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Connecting..." />

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU Usage" />
                        <TextBlock x:Name="CpuUsageText" Style="{StaticResource SubtitleTextBlockStyle}" Text="-" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU Clock" />
                        <TextBlock x:Name="CpuClockText" Style="{StaticResource SubtitleTextBlockStyle}" Text="-" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Responsiveness" />
                        <TextBlock x:Name="ResponsivenessText" Style="{StaticResource SubtitleTextBlockStyle}" Text="-" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Memory Usage" />
                        <TextBlock x:Name="MemoryText" Style="{StaticResource SubtitleTextBlockStyle}" Text="-" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="CPU and Memory Usage" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Height="180">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" VerticalAlignment="Top" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="100%" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="75%" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="50%" />
                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="25%" />
                            <TextBlock Grid.Row="4" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0%" />
                        </Grid>
                        <Canvas x:Name="HistoryCanvas" Grid.Column="1" Height="180" SizeChanged="HistoryCanvas_SizeChanged" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Foreground="#F59E0B" Text="CPU %" />
                        <TextBlock Foreground="#60A5FA" Text="Memory %" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="CPU Cores" />
                    <GridView
                        x:Name="CoreGrid"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="90" HorizontalAlignment="Center" Spacing="6">
                                    <Grid Width="70" Height="70">
                                        <Ellipse Fill="#1F2937" Stroke="#334155" StrokeThickness="1" />
                                        <Path Data="{Binding SliceGeometry}" Fill="#22C55E" />
                                        <Ellipse Stroke="#334155" StrokeThickness="1" Fill="Transparent" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding UsageText}" />
                                    </Grid>
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding Label}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Top Active Processes" />
                    <Grid Margin="0,0,0,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MainSortNameBtn" Content="Name" HorizontalAlignment="Left" Click="MainProcessHeaderSort_Click" Tag="name" Padding="0" MinWidth="0" BorderThickness="0" Background="Transparent" />
                        <Button x:Name="MainSortOwnerBtn" Grid.Column="1" Content="Owner" HorizontalAlignment="Left" Click="MainProcessHeaderSort_Click" Tag="owner" Padding="0" MinWidth="0" BorderThickness="0" Background="Transparent" />
                        <Button x:Name="MainSortPidBtn" Grid.Column="2" Content="PID" HorizontalAlignment="Left" Click="MainProcessHeaderSort_Click" Tag="pid" Padding="0" MinWidth="0" BorderThickness="0" Background="Transparent" />
                        <Button x:Name="MainSortPriorityBtn" Grid.Column="3" Content="Priority" HorizontalAlignment="Left" Click="MainProcessHeaderSort_Click" Tag="priority" Padding="0" MinWidth="0" BorderThickness="0" Background="Transparent" />
                        <Button x:Name="MainSortCpuBtn" Grid.Column="4" Content="CPU %" HorizontalAlignment="Left" Click="MainProcessHeaderSort_Click" Tag="cpu" Padding="0" MinWidth="0" BorderThickness="0" Background="Transparent" />
                        <Button x:Name="MainSortLocationBtn" Grid.Column="5" Content="Location" HorizontalAlignment="Left" Click="MainProcessHeaderSort_Click" Tag="location" Padding="0" MinWidth="0" BorderThickness="0" Background="Transparent" />
                    </Grid>
                    <ListView x:Name="ProcessList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Owner}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PidText}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Priority}" />
                                    <TextBlock Grid.Column="4" Text="{Binding CpuText}" />
                                    <TextBlock Grid.Column="5" Text="{Binding Location}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

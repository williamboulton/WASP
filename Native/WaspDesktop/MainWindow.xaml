<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WaspDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WaspDesktop"
    xmlns:services="using:WaspDesktop.Services"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WASP Monitor"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="WASP Monitor"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid Grid.Row="1">
            <NavigationView
                x:Name="NavView"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                SelectionChanged="NavView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem
                        Content="Main"
                        IsSelected="True"
                        Tag="main">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Memory" Tag="memory">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE950;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Disk" Tag="disk">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEDA2;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Processes" Tag="processes">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7F8;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <Frame x:Name="NavFrame" />
            </NavigationView>

            <Button
                x:Name="NotificationButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,14,14,0"
                Padding="8,6"
                ToolTipService.ToolTip="Notifications">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7F4;" />
                    <TextBlock Text="Notifications" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <Grid Width="420" MaxHeight="460" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Notifications" />
                                <Button Grid.Column="1" Content="Clear" Click="ClearNotifications_Click" />
                            </Grid>

                            <ListView
                                Grid.Row="1"
                                MaxHeight="380"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollMode="Enabled"
                                ItemsSource="{x:Bind NotificationHistory, Mode=OneWay}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="services:AppNotification">
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            CornerRadius="8"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind TimeText}" />
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind SeverityText}" />
                                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                </StackPanel>
                                                <TextBlock TextWrapping="Wrap" Text="{x:Bind Message}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <ItemsControl
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,56,14,0"
                IsHitTestVisible="False"
                ItemsSource="{x:Bind ActiveToasts, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:AppNotification">
                        <Border
                            Width="320"
                            Padding="10"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind TimeText}" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind SeverityText}" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{x:Bind Message}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>

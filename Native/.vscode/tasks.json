{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ (MSVC)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\build.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run sysinfo.exe",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\sysinfo.exe",
            "dependsOn": "Build C++ (MSVC)",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}

